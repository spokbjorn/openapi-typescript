{
  "name": "@spokbjorn/openapi-typescript-generator",
  "version": "0.0.2-pre.0",
  "description": "Standalone generator for TypeScript types from OpenAPI specs, with CLI and programmatic API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "openapi-typescript-generator": "./bin/openapi-typescript-generator.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "openapi-typescript": "catalog:"
  },
  "devDependencies": {
    "@spokbjorn/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "openapi",
    "swagger",
    "typescript",
    "codegen",
    "generator",
    "cli"
  ]
}
